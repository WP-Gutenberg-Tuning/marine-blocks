{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "skvn-marine/responsive-spacer",
  "version": "1.3.20",
  "title": "Responsive Spacer",
  "category": "skvn-marine",
  "icon": "image-flip-vertical",
  "description": "Add vertical spacing with separate desktop, tablet, and mobile values.",
  "textdomain": "skvn-marine-blocks",
  "style": "skvn-marine-responsive-spacer",
  "attributes": {
    "desktopHeight": {
      "type": "number",
      "default": 30
    },
    "tabletHeight": {
      "type": "number"
    },
    "mobileHeight": {
      "type": "number"
    }
  },
  "supports": {
    "html": false,
    "customClassName": false
  }
}