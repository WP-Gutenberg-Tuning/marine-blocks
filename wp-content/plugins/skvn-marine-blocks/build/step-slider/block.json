{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "skvn-marine/step-slider",
  "version": "1.3.23",
  "title": "Step Slider",
  "category": "skvn-marine",
  "icon": "images-alt2",
  "description": "Fullscreen step slider with manual navigation, fade, wipe and text cascade.",
  "textdomain": "skvn-marine-blocks",
  "allowedBlocks": [
    "skvn-marine/step-slide"
  ],
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    },
    "autoplay": {
      "type": "boolean",
      "default": true
    },
    "dwellPreset": {
      "type": "string",
      "enum": [
        "5",
        "8",
        "10"
      ],
      "default": "8"
    },
    "loop": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  }
}