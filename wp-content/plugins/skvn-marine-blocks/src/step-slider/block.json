{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "skvn-marine/step-slider",
  "version": "1.3.25",
  "title": "Step Slider",
  "category": "skvn-marine",
  "icon": "images-alt2",
  "description": "Fullscreen step slider with manual navigation, fade, wipe, and text animation.",
  "textdomain": "skvn-marine-blocks",
  "allowedBlocks": [
    "skvn-marine/step-slide"
  ],
  "providesContext": {
    "skvn-marine/stepFillPreset": "fillPreset"
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    },
    "autoplay": {
      "type": "boolean",
      "default": true
    },
    "pauseOnHover": {
      "type": "boolean",
      "default": true
    },
    "showPlayButton": {
      "type": "boolean",
      "default": true
    },
    "dwellPreset": {
      "type": "string",
      "enum": [
        "5",
        "8",
        "10"
      ],
      "default": "8"
    },
    "loop": {
      "type": "boolean",
      "default": true
    },
    "heightMode": {
      "type": "string",
      "enum": [
        "viewport",
        "tall",
        "content"
      ],
      "default": "viewport"
    },
    "tabHeight": {
      "type": "number",
      "default": 54
    },
    "progressColor": {
      "type": "string",
      "default": "#7ec8e3"
    },
    "textAnimation": {
      "type": "string",
      "enum": [
        "slide",
        "rise"
      ],
      "default": "slide"
    },
    "fillPreset": {
      "type": "string",
      "default": "deep-marine"
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  }
}
